# =======================================================
# CONFIGURACIÓN DEL SERVIDOR
# =======================================================
PORT=3001
NODE_ENV=development

# =======================================================
# CONFIGURACIÓN DE LA BASE DE DATOS POSTGRESQL (Prisma)
# =======================================================

# DATABASE_URL: Cadena de conexión usada por la aplicación (pooler en producción)
DATABASE_URL="postgresql://usuario:password@host:5432/huellitas?schema=public"

# DIRECT_URL: Cadena directa usada por las migraciones (Supabase direct connection)
DIRECT_URL="postgresql://usuario:password@host:5432/huellitas?schema=public"

# Otras variables como JWT_SECRET, etc., irán aquí